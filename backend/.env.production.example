# Plantilla de PRODUCCIÓN. Cópiala a backend/.env.production (NO se versiona) y arranca con:
#   ENV_FILE=.env.production  (variable de entorno del servicio)
# Parte de .env.example (cada variable está documentada ahí); estos son los valores que DEBEN ser distintos a los de pruebas.

APP_ENV=production
DEMO_MODE=false
COOKIE_SECURE=true
FRONTEND_ORIGIN=https://asignacion.tu-dominio.com
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Base OFICIAL. Usuario SQL dedicado y mínimo (nunca sa ni db_owner)
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=yes
# Con certificado válido en el servidor SQL, pon no
DB_TRUST_SERVER_CERTIFICATE=no
# O bien una cadena completa (autenticación integrada)
DB_CONNECTION_STRING=

# Objetos reales de producción (confirmar nombres con el DBA)
AGENCIAS_TABLA=Cat.vw_Agencias
AGENCIAS_COLUMNA_VALOR=AGENCIA
AGENCIAS_COLUMNA_NOMBRE=AGENCIA
CATALOGO_DISTRITO_TABLA=Cat.Cat_Asig_Distrito
CATALOGO_MUNICIPIO_TABLA=Cat.Cat_Asig_Municipio
# ...y el resto de BAJAS_*, CAMBIO_TEC_*, SP_*, MORA_*, ASIGNACION_* como en .env.example
