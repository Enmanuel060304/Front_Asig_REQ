# ===== SQL Server =====
DB_SERVER=servidor\instancia
# Vacío si usas instancia con nombre
DB_PORT=1433
DB_NAME=NombreBaseDatos
DB_USER=usuario_sql
DB_PASSWORD=contraseña_sql
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
# Opcional: cadena ODBC completa. Si se llena, reemplaza a las variables DB_* de arriba
# (p. ej. autenticación integrada: DRIVER={ODBC Driver 18 for SQL Server};SERVER=srv;DATABASE=bd;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes)
DB_CONNECTION_STRING=

# ===== Insumo: Bajas =====
# Tabla donde se valida el periodo (1 a 4 partes, p.ej. [LINKED_SRV].[Base].[dbo].[Bajas])
BAJAS_TABLA=dbo.Bajas
# Columna con el periodo YYYYMM (número o texto)
BAJAS_COLUMNA_PERIODO=Periodo
# SP que extrae la información del servidor origen
SP_EXTRAER_BAJAS=dbo.sp_ExtraerBajas
# Vacío = el SP no recibe parámetros. Ej. @Periodo = se le pasa el periodo esperado (202609)
SP_EXTRAER_BAJAS_PARAM_PERIODO=

# ===== Insumo: Cambio de tecnología =====
CAMBIO_TEC_TABLA=dbo.CambioTecnologia
CAMBIO_TEC_COLUMNA_PERIODO=Periodo
SP_EXTRAER_CAMBIO_TEC=dbo.sp_ExtraerCambioTecnologia
SP_EXTRAER_CAMBIO_TEC_PARAM_PERIODO=

# Timeout de las extracciones en segundos (0 = sin límite)
EXTRACCION_TIMEOUT_SECONDS=0
# Advertencia si las filas varían más de este % respecto al periodo anterior
VARIACION_ALERTA_PCT=30

# ===== Mora =====
SP_MORA=dbo.sp_GenerarMora
# Tabla que llena el SP de mora (se cuentan sus filas al terminar)
MORA_TABLA=dbo.Mora
MORA_TIMEOUT_SECONDS=0

# ===== Asignación =====
SP_ASIGNACION=dbo.sp_GenerarAsignacion
ASIGNACION_TIMEOUT_SECONDS=0

# Tabla que llena el SP de asignación (lo nuevo + pendientes de periodos anteriores).
# Se listan los equipos sin agencia (NULL) y se exporta completa a Excel
ASIGNACION_TABLA=dbo.Asignacion
# Identificador único del equipo (serie, IMEI…)
ASIGNACION_COLUMNA_ID=Serie
# Columna de la agencia que el SP deja en NULL cuando los datos no cuadran
ASIGNACION_COLUMNA_AGENCIA=Agencia
# Columnas que se muestran en "Equipos sin asignar" (separadas por comas)
ASIGNACION_COLUMNAS_VISIBLES=Serie,Municipio,Barrio,Direccion

# ===== Agencias =====
# Catálogo de agencias vigentes (puede ser una vista que filtre las activas).
# Con el módulo Catálogo: la vista Cat.vw_Agencias (backend/sql/006_catalogo_vista_agencias.sql)
AGENCIAS_TABLA=Cat.vw_Agencias
# Valor que se escribe en la columna de agencia de la asignación (id o nombre)
AGENCIAS_COLUMNA_VALOR=AGENCIA
# Texto que ve el usuario al elegir
AGENCIAS_COLUMNA_NOMBRE=AGENCIA

# ===== Módulo Catálogo de agencias (mapeos distrito/municipio → agencia) =====
# Estos son los valores por defecto; solo se declaran si en tu base se llaman distinto
CATALOGO_DISTRITO_TABLA=Cat.Cat_Asig_Distrito
CATALOGO_DISTRITO_COLUMNA=DISTRITO
CATALOGO_MUNICIPIO_TABLA=Cat.Cat_Asig_Municipio
CATALOGO_MUNICIPIO_COLUMNA_ID=ID
CATALOGO_MUNICIPIO_COLUMNA=MUNICIPIO
CATALOGO_COLUMNA_AGENCIA=AGENCIA

# ===== Programación =====
APP_TIMEZONE=America/Managua
# Minutos de tolerancia para ejecutar una programación vencida (servidor apagado u otro proceso en curso)
PROGRAMACION_TOLERANCIA_MIN=120

# ===== Seguridad / JWT =====
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRE_MINUTES=480
# true en producción (HTTPS)
COOKIE_SECURE=false

# ===== App =====
# development | production. Con production la app NO arranca si DEMO_MODE=true, COOKIE_SECURE=false
# o JWT_SECRET es corto (<32) o el de ejemplo
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
