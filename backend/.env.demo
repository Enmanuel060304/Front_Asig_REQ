# Configuración del modo demo (npm run dev:demo): sin SQL Server, con datos ficticios en memoria.
# No contiene secretos reales; no usar en producción.
DEMO_MODE=true

DB_SERVER=demo
DB_NAME=demo
DB_USER=demo
DB_PASSWORD=demo

BAJAS_TABLA=dbo.Bajas
BAJAS_COLUMNA_PERIODO=Periodo
SP_EXTRAER_BAJAS=dbo.sp_ExtraerBajas
CAMBIO_TEC_TABLA=dbo.CambioTecnologia
CAMBIO_TEC_COLUMNA_PERIODO=Periodo
SP_EXTRAER_CAMBIO_TEC=dbo.sp_ExtraerCambioTecnologia
SP_MORA=dbo.sp_GenerarMora
MORA_TABLA=dbo.Mora
SP_ASIGNACION=dbo.sp_GenerarAsignacion

ASIGNACION_TABLA=dbo.Asignacion
ASIGNACION_COLUMNA_ID=Serie
ASIGNACION_COLUMNA_AGENCIA=Agencia
ASIGNACION_COLUMNAS_VISIBLES=Contrato,Serie,Departamento,Municipio,Barrio,Direccion
ASIGNACION_COLUMNAS_EDITABLES=Departamento,Municipio,Barrio

AGENCIAS_TABLA=dbo.Agencias
AGENCIAS_COLUMNA_VALOR=IdAgencia
AGENCIAS_COLUMNA_NOMBRE=Nombre

APP_TIMEZONE=America/Bogota
JWT_SECRET=demo-solo-para-pruebas-no-usar-en-produccion
